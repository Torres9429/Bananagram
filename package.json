{
  "name": "gestor-redes-monorepo",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "seed": "pnpm --filter seed run start",
    "db:generate": "npx prisma generate --schema=apps/backend/commons/prisma/schema.prisma",
    "db:migrate": "npx prisma migrate dev --schema=apps/backend/commons/prisma/schema.prisma",
    "db:migrate:prod": "npx prisma migrate deploy --schema=apps/backend/commons/prisma/schema.prisma",
    "db:studio": "npx prisma studio --schema=apps/backend/commons/prisma/schema.prisma"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --fix", "prettier --write"]
  }
}
