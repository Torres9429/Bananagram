# Copia este archivo y ajusta lo que necesites. Los valores por defecto ya
# funcionan para desarrollo local con `docker compose up -d`.

# Misma base física que core-service (gestor_redes_core) — alexa-service NO
# es dueña de este schema, solo tiene acceso directo de lectura/escritura al
# modelo ContentIdea (ver prisma/schema.prisma). Nunca correr `prisma
# migrate` con esta URL desde aquí.
DATABASE_URL_CORE=postgresql://postgres:postgres@localhost:5433/gestor_redes_core

# RS256 + JWKS: alexa-service verifica contra la llave pública remota de
# auth-service, nunca firma.
JWT_ISSUER=bananagram-auth
JWT_AUDIENCE=bananagram-api
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json

REDIS_URL=redis://127.0.0.1:6379

# campañas/métricas se consumen por HTTP contra core-service (BFF normal);
# el account-linking (LinkCode) se consume por HTTP contra auth-service.
CORE_SERVICE_URL=http://localhost:3002
AUTH_SERVICE_URL=http://localhost:3001

# GenerateContentIdeasIntent / GetIdeaRecommendationsIntent (agregado
# 2026-08-18) — mismo BFF por HTTP, ahora contra ai-service.
AI_SERVICE_URL=http://localhost:3005

NODE_ENV=development
