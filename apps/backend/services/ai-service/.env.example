# Copia este archivo a .env y ajusta lo que necesites. ai-service no tiene
# base de datos propia (a diferencia de auth/core-service).

# OpenRouter — nunca hardcodear la key. Obtenerla en https://openrouter.ai
# (Settings → API Keys). Deja OPENROUTER_MODEL vacío o con este default y
# verifica el slug vigente en
# https://openrouter.ai/models?fmt=cards&input_modalities=text,image&max_price=0
# antes de usarlo — el catálogo de modelos gratis (":free") cambia seguido.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash

# RS256 + JWKS: ai-service verifica contra la llave pública remota de
# auth-service, nunca firma (mismo mecanismo que core-service/alexa-service).
JWT_ISSUER=bananagram-auth
JWT_AUDIENCE=bananagram-api
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json

REDIS_URL=redis://127.0.0.1:6379

# analyze-post/improve-post reenvían el Bearer del caller a
# GET /api/posts/:id de core-service para reusar su propia validación de
# pertenencia (dueño de marca / CM asignado / diseñador asignado / admin) —
# ai-service nunca consulta Prisma directo.
CORE_SERVICE_URL=http://localhost:3002

NODE_ENV=development
