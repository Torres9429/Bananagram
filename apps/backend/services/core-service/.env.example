# Copia este archivo a .env y ajusta lo que necesites. Los valores por
# defecto ya funcionan para desarrollo local con `docker compose up -d`.

# auth-service y core-service tienen bases de datos separadas (ver
# docs/base/modelo2.txt) — puerto 5433 es el que expone docker-compose.yml.
DATABASE_URL_CORE=postgresql://postgres:postgres@localhost:5433/gestor_redes_core

# RS256 + JWKS: core-service verifica contra la llave pública remota de
# auth-service, nunca firma (nunca lee un .pem propio).
JWT_ISSUER=bananagram-auth
JWT_AUDIENCE=bananagram-api
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json

# Primera llamada saliente de core-service hacia auth-service (Fase J,
# notificaciones — POST /internal/notifications, no proxiado por el gateway).
AUTH_SERVICE_URL=http://localhost:3001

# Secreto compartido para tráfico servicio-a-servicio hacia /internal/* (en
# ambas direcciones: auth->core para user-profiles, core->auth para
# notifications) — InternalAuthGuard, header X-Internal-Token. Mismo valor
# debe estar configurado en auth-service/.env.
INTERNAL_SERVICE_SECRET=dev-internal-secret-change-me

REDIS_URL=redis://127.0.0.1:6379

# Ayrshare — usado por core-service al crear una marca (perfil + connect URL
# para vincular redes sociales, ver brands.service.ts) y al sincronizar redes
# conectadas (social-accounts.service.ts). Sin estos 4 valores, POST /brands
# y POST /brands/:id/social-accounts/sync fallan con 500.
AYRSHARE_API_KEY=
AYRSHARE_DOMAIN=
AYRSHARE_PRIVATE_KEY=
AYRSHARE_API_BASE_URL=https://api.ayrshare.com/api

# mock|ayrshare — decide si el scheduler de posts y el cron de métricas usan
# el simulador o Ayrshare real (ver integrations/ayrshare/ayrshare.module.ts).
# Default mock: no gasta el trial mientras se itera en algo ajeno a Ayrshare.
SOCIAL_PROVIDER=mock

# S3 (reemplazó a Cloudinary, ver src/storage/s3.service.ts) — sin credenciales
# estáticas: el SDK usa el rol de instancia de EC2 en producción, o
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/~/.aws/credentials en local. El
# bucket debe permitir s3:GetObject público en el prefijo bananagram/posts/*
# (mismo comportamiento que las URLs públicas que devolvía Cloudinary).
AWS_REGION=us-east-1
S3_BUCKET_NAME=

NODE_ENV=development
