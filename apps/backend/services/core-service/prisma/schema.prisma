// Schema propio de core-service — copiado de la sección "core-service" de
// docs/base/modelo2.txt (fuente de verdad del modelo de datos). Dueño de:
// catálogos (Category/Specialty/SocialNetwork), marcas, redes sociales,
// campañas y su equipo, publicaciones, su máquina de estados y fan-out
// multi-red, medios, métricas simuladas, score digital, reportes e ideas de
// contenido. Base de datos propia (DATABASE_URL_CORE), separada de
// auth-service.
//
// Nota: `User` y `UserProfile` NO tienen @relation real entre sí a nivel de
// Prisma pese a que modelo2.txt los dibuja como relacionados — viven en
// bases de datos distintas (auth-service vs. core-service), y Prisma no
// soporta relaciones cruzando datasources. `UserProfile.userId` es una FK
// "tonta" (mismo patrón que ownerId/cmId/createdBy en el resto de este
// archivo): el id ya viene del JWT al escribir, sin necesidad de @relation.

// output personalizado — ver comentario en auth-service/prisma/schema.prisma
// (mismo motivo: evitar que pnpm resuelva ambos Prisma Client al mismo
// folder físico por compartir versión).
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_CORE")
}

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique // FK → auth-service.User.id (sin constraint de BD)

  name      String
  avatarUrl String?

  // Denormalizado desde auth-service.User.roles (multi-rol) al momento del
  // registro (ver POST /internal/user-profiles) — valores de
  // 'cliente' | 'cm' | 'disenador', mismos que RegisterDto.roleName.
  // Necesario porque core-service no tiene ninguna otra forma de conocer
  // los roles de un usuario (Role vive solo en auth-service, sin @relation
  // cruzando datasources) y las campañas necesitan validar que
  // cmId/designerId correspondan a un CM/Diseñador real. Array (no más un
  // solo valor nullable) porque un usuario puede tener varios roles a la
  // vez (ver auth-service UserRole) — @default([]) en vez de null: sigue
  // siendo best-effort (si core-service estaba caído durante el registro,
  // puede faltar hasta que el upsert se reintente), pero un array vacío es
  // más simple de consultar con `{ has: roleName }` que un null.
  roleNames String[] @default([])

  categories  UserProfileCategory[]
  specialties UserProfileSpecialty[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("user_profiles")
}

model UserProfileCategory {
  userProfileId String
  categoryId    String

  userProfile UserProfile @relation(fields: [userProfileId], references: [id])
  category    Category    @relation(fields: [categoryId], references: [id])

  @@id([userProfileId, categoryId])
  @@map("user_profile_categories")
}

model UserProfileSpecialty {
  userProfileId String
  specialtyId   String

  userProfile UserProfile @relation(fields: [userProfileId], references: [id])
  specialty   Specialty   @relation(fields: [specialtyId], references: [id])

  @@id([userProfileId, specialtyId])
  @@map("user_profile_specialties")
}

// ── Catálogos ─────────────────────────────────────────────────────────

// Áreas temáticas: clasifican a usuarios operativos (CM/Diseñador),
// campañas y marcas. Es el eje del sistema de matching (orientativo, no
// restrictivo — regla de negocio #8). Catálogo base de core-service.
model Category {
  id   String @id @default(uuid())
  name String @unique

  userProfileCategories UserProfileCategory[]
  campaignCategories    CampaignCategory[]
  brands                Brand[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("categories")
}

// Habilidades técnicas exclusivas de CM y Diseñador. NO aplica a marcas ni
// campañas.
model Specialty {
  id   String @id @default(uuid())
  name String @unique

  userProfileSpecialties UserProfileSpecialty[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("specialties")
}

// Plataformas de publicación disponibles en el sistema. Gestionado solo
// por Admin (un INSERT = nueva red, sin deploy).
//
// baseEngagementRate: leído por el cron de simulación de métricas — lectura
// local normal, mismo servicio.
model SocialNetwork {
  id                 String @id @default(uuid())
  name               String
  code               String @unique // 'instagram' | 'tiktok' | etc.
  baseEngagementRate Float

  socialAccounts SocialAccount[]
  postSocialNetworks PostSocialNetwork[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("social_networks")
}

model Brand {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  profileType String?

  // Reusa el mismo catálogo de Category que ya usan Campañas y los perfiles
  // de CM/Diseñador (moda, entretenimiento, deportes...) — orientativo, no
  // restrictivo (regla de negocio #8), single-select a propósito.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  logoUrl      String?
  primaryColor String?

  // dueño — siempre un Cliente
  ownerId String // FK → auth-service.User.id (sin constraint de BD; resolver
  // vía HTTP GET /internal/users/:id si la vista necesita nombre/email —
  // para validar propiedad basta comparar contra el userId del JWT, sin llamada)

  refId      String? @unique
  profileKey String? @unique

  // Zona horaria por defecto de la marca — falta por completo hoy (§13 de
  // la auditoría de integración Ayrshare); nullable a propósito, con
  // fallback a un default de aplicación en código (no forzar backfill).
  timezone String?

  socialAccounts SocialAccount[]
  campaigns      Campaign[]
  posts          Post[]
  media          Media[]
  scores         BrandScore[]
  reports        Report[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("brands")
}

model SocialAccount {
  id              String        @id @default(uuid())
  brandId         String
  brand           Brand         @relation(fields: [brandId], references: [id])
  socialNetworkId String
  socialNetwork   SocialNetwork @relation(fields: [socialNetworkId], references: [id])
  handle          String? // @username en esa red

  followers Int     @default(0)
  active    Boolean @default(true)

  // Campos nuevos para la integración real con Ayrshare (auditoría §2/§6):
  // id que Ayrshare/la red asigna a la cuenta conectada (mapear
  // webhooks/eventos sin depender de `handle`, frágil), cuándo se
  // desconectó de verdad (distinto de `active: false`, que no dice cuándo
  // pasó), y última reautenticación (TikTok exige reautorizar cada año).
  platformAccountId  String?
  disconnectedAt     DateTime?
  lastAuthenticatedAt DateTime?

  postSocialAccounts PostSocialAccount[]
  metricSnapshots    SocialAccountMetricSnapshot[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([brandId, socialNetworkId])
  @@map("social_accounts")
}

// Historial de seguidores por cuenta conectada — a diferencia de
// SocialAccount.followers (un solo número, se pisa en cada sync), esta tabla
// nunca hace update, solo insert (mismo patrón append-only que PostMetric) —
// permite graficar crecimiento aunque la marca no tenga ninguna campaña
// todavía. Poblada por account-metrics-cron.service.ts cada 6h.
model SocialAccountMetricSnapshot {
  id              String        @id @default(uuid())
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id])

  followers Int
  // Métricas de cuenta completa (todas las publicaciones, no una en
  // particular) confirmadas en vivo contra POST /analytics/social de
  // Ayrshare — nullable, null = no disponible, nunca 0 de relleno (mismo
  // criterio que PostMetric). Ayrshare NO expone "visitas al perfil" en
  // este endpoint — no se agrega ese campo porque no hay de dónde llenarlo.
  likes    Int?
  comments Int?
  shares   Int?
  views    Int?
  reach    Int?
  // Total de publicaciones de la cuenta completa (no solo las hechas desde
  // Bananagram) — confirmado en vivo (2026-08-18): Instagram expone
  // `mediaCount`, TikTok `videoCountTotal`. Facebook/X no traen un campo
  // equivalente en este endpoint, queda null ahí a propósito (mismo
  // criterio "null = no disponible, nunca 0" del resto de este modelo).
  posts    Int?

  // Demografía de audiencia — confirmado en vivo (esta sesión) que el shape
  // real es { "F.25-34": 15, ... } y { "US": 161, ... }. Sigue null en
  // cuentas nuevas: Instagram exige ≥100 interacciones en 30 días para
  // liberarlo, condición de la plataforma, no de este código.
  audienceGenderAge Json?
  audienceCountry   Json?

  source     String   @default("simulated") // 'ayrshare' | 'simulated'
  capturedAt DateTime @default(now())

  @@map("social_account_metric_snapshots")
}

model Campaign {
  id          String         @id @default(uuid())
  brandId     String
  brand       Brand          @relation(fields: [brandId], references: [id])
  name        String
  description String?
  objective   String?
  status      CampaignStatus @default(active)
  startDate   DateTime?
  endDate     DateTime?

  // El CM vive directo aquí — FK única garantiza "solo un CM por campaña"
  // en BD. FK → auth-service.User.id (sin constraint).
  cmId String

  // Flujo de aceptación (Fase J): cmId queda fijo solo una vez ACEPTADA —
  // antes de eso el Cliente puede reasignarlo (ej. si el CM rechaza), lo que
  // resetea este bloque a 'pendiente' de nuevo. Separado de `status`
  // (active/paused/finished, que es el ciclo de vida operativo) a propósito:
  // son dos preguntas distintas ("¿el CM confirmó?" vs "¿la campaña está
  // corriendo?").
  cmStatus         CmAssignmentStatus @default(pendiente)
  cmRespondedAt    DateTime?
  cmRejectionReason String?

  designers  CampaignDesigner[]
  categories CampaignCategory[]
  posts      Post[]
  ideas      ContentIdea[]

  createdBy String // FK → auth-service.User.id (Cliente que la creó; sin
  // constraint, no requiere llamada para escribir — viene del JWT)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("campaigns")
}

model CampaignDesigner {
  campaignId String
  userId     String // FK → auth-service.User.id (sin constraint de BD)
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  @@id([campaignId, userId])
  @@map("campaign_designers")
}

// Equipo GENERAL de un CM (Fase J) — distinto de CampaignDesigner, que es
// por-campaña. Un Diseñador debe estar aquí antes de poder ser asignado a
// una campaña puntual de ese mismo CM. Sin soft-delete: quitar del equipo es
// un DELETE real, igual que ya hace CampaignDesigner (es una relación viva,
// no un registro con historia que conservar).
model CmTeamMember {
  cmUserId       String // FK → auth-service.User.id (sin constraint de BD)
  designerUserId String // FK → auth-service.User.id (sin constraint de BD)

  createdAt DateTime @default(now())

  @@id([cmUserId, designerUserId])
  @@map("cm_team_members")
}

model CampaignCategory {
  campaignId String
  categoryId String

  campaign Campaign @relation(fields: [campaignId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([campaignId, categoryId])
  @@map("campaign_categories")
}

enum CampaignStatus {
  active
  paused
  finished
}

// Aceptación del CM (Fase J) — separado de CampaignStatus, ver comentario en
// Campaign.cmStatus.
enum CmAssignmentStatus {
  pendiente
  aceptada
  rechazada
}

// Estado único de la publicación: cubre tanto el flujo de aprobación
// (borrador → en_revision → aprobado/rechazado) como el de publicación
// multi-red (programado → publicando → publicado/parcial/error/cancelado).
// post_status_history registra cada transición (actor, fecha, comentario).
enum PostStatus {
  borrador
  en_revision
  aprobado
  rechazado
  rechazado_cliente
  programado
  publicando
  publicado
  parcial
  error
  cancelado
}

enum PostSocialAccountStatus {
  pendiente
  publicando
  publicado
  error
  cancelado
}

// Capa 1 — La intención del usuario (independiente de la red)
model Post {
  id         String    @id @default(uuid())
  brandId    String
  brand      Brand     @relation(fields: [brandId], references: [id])
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id])

  content     String     @db.Text
  instructions String?    @db.Text
  status      PostStatus @default(borrador)
  scheduledAt DateTime?
  publishedAt DateTime?

  createdBy String // FK → auth-service.User.id (CM o Diseñador; sin
  // constraint, viene del JWT al escribir)

  // null hasta que Ayrshare acepta el post
  ayrsharePostId String? @unique

  socialAccounts PostSocialAccount[]
  socialNetworks PostSocialNetwork[]
  statusHistory  PostStatusHistory[]
  media          PostMedia[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("posts")
}

// Inmutable — historial de transiciones de estado del Post
model PostStatusHistory {
  id         BigInt      @id @default(autoincrement())
  postId     String
  post       Post        @relation(fields: [postId], references: [id])
  fromStatus PostStatus?
  toStatus   PostStatus
  changedBy  String // FK → auth-service.User.id (sin constraint; JWT al escribir)
  comment    String?     @db.Text // obligatorio si toStatus = rechazado o cancelado

  createdAt DateTime @default(now())

  @@map("post_status_history")
}

// Capa 2 — Publicación física por red social
model PostSocialAccount {
  id              String        @id @default(uuid())
  postId          String
  post            Post          @relation(fields: [postId], references: [id])
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id])

  status       PostSocialAccountStatus @default(pendiente)
  socialPostId String? // ID devuelto por la red (vía Ayrshare)
  postUrl      String?
  publishedAt  DateTime?
  errorMessage String?

  // Campos nuevos para el pipeline real de publicación/sync (auditoría
  // §2/§13/§16): estado crudo que reporta Ayrshare (separado del enum
  // interno, para depurar cuando divergen), clasificación de error (para
  // saber qué reintentar), contador de reintentos, última vez que se
  // consultó el estado real a Ayrshare, cuándo se mandó la solicitud y la
  // fecha que Ayrshare confirma que va a publicar (puede diferir de la
  // solicitada).
  providerStatus      String?
  errorCode           String?
  retryCount          Int       @default(0)
  lastSyncedAt        DateTime?
  submittedAt         DateTime?
  providerScheduledAt DateTime?

  metrics PostMetric[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, socialAccountId])
  @@map("post_social_accounts")
}

model PostSocialNetwork {
  postId          String
  socialNetworkId String

  post          Post          @relation(fields: [postId], references: [id])
  socialNetwork SocialNetwork @relation(fields: [socialNetworkId], references: [id])

  @@id([postId, socialNetworkId])
  @@map("post_social_networks")
}

// ── Biblioteca de medios ────────────────────────────────────────────────
model Media {
  id      String @id @default(uuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])


  fileName     String
  originalName String
  mimeType     String
  url          String
  size         Int
  width        Int?
  height       Int?
  duration     Int? // solo video

  postMedia PostMedia[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("media")
}

model PostMedia {
  postId  String
  mediaId String
  order   Int

  post  Post  @relation(fields: [postId], references: [id])
  media Media @relation(fields: [mediaId], references: [id])

  @@id([postId, mediaId])
  @@map("post_media")
}

// ── Ideas de contenido ──────────────────────────────────────────────────
// Capturadas por la Alexa Skill (vía alexa-service, sin BD propia) y,
// potencialmente, desde el panel web más adelante.
enum ContentIdeaSource {
  sugerida // generada por GenerateContentIdeasIntent y guardada tal cual
  propia   // dictada libremente por el usuario (SaveCustomIdeaIntent)
}

model ContentIdea {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  createdBy String // FK → auth-service.User.id (sin constraint de BD; viene
  // del JWT al escribir, sin llamada — mismo patrón que Post.createdBy)

  title  String? // null cuando source = propia y el usuario no dictó título
  text   String  @db.Text
  source ContentIdeaSource @default(sugerida)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("content_ideas")
}

// Capa 3 — Snapshot de métricas por red (cron job).
model PostMetric {
  id                  String            @id @default(uuid())
  postSocialAccountId String
  postSocialAccount   PostSocialAccount @relation(fields: [postSocialAccountId], references: [id])

  likes      Int?
  comments   Int?
  shares     Int?
  views      Int?
  reach      Int?
  engagement Float? // tasa calculada: (likes+comments+shares) / reach

  // Campos nuevos (auditoría §2/§7/§8): respuesta cruda del proveedor (vida
  // corta en varias redes — TikTok expira a los 7 días, X a los 30, así que
  // conservarla aquí es la única forma de no perderla), quién generó esta
  // fila ('simulated' | 'ayrshare' — crítico para no mezclar datos falsos
  // con reales sin marcarlos), y qué denominador se usó para `engagement`
  // cuando `reach` no está disponible para esa red.
  raw            Json?
  source         String  @default("simulated")
  engagementBase String? // 'reach' | 'views' | 'impressions'

  capturedAt DateTime @default(now())

  @@map("post_metrics")
}

// Trazabilidad de cada llamada saliente a un proveedor externo (Ayrshare) —
// distinto de AuditLog, que audita mutaciones de dominio, no llamadas HTTP a
// terceros (auditoría §2/§16/§17). Nunca guarda el body completo de la
// request/response ni la API key — solo metadatos, para poder correlacionar
// reintentos y detectar duplicados por `requestId`.
model ProviderRequestLog {
  id         String   @id @default(uuid())
  provider   String   @default("ayrshare")
  operation  String // 'publish' | 'analytics' | 'connectProfile' | ...
  entityType String // 'post' | 'socialAccount' | 'brand'
  entityId   String
  requestId  String? // correlation id, para cruzar con logs
  httpStatus Int?
  succeeded  Boolean
  errorCode  String?
  durationMs Int?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@map("provider_request_logs")
}

// Registro de cada corrida del cron de sincronización de métricas
// (auditoría §2/§9/§10) — para saber si el cron corrió, qué tan bien, y
// cuándo fue la última sincronización exitosa.
model MetricSyncRun {
  id             String    @id @default(uuid())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  itemsProcessed Int       @default(0)
  itemsFailed    Int       @default(0)
  status         String // 'running' | 'completed' | 'failed'

  @@map("metric_sync_runs")
}

// Score = (Consistencia×0.30) + (Engagement×0.40) + (Frecuencia×0.30) — ver
// CLAUDE.md sobre la discrepancia entre la fórmula documentada (3 factores)
// y la implementada hoy en score.service.ts (4 factores, incluye
// Cobertura×0.20) — confirmar con el usuario cuál es la vigente antes de
// tocar el cálculo real.
// `coverage` es informativa: NO entra al cálculo ponderado del score.
model BrandScore {
  id      String @id @default(uuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  score          Float
  consistency    Float
  engagement     Float
  frequency      Float
  coverage       Float
  classification String
  snapshotDate   DateTime @default(now())

  @@map("brand_scores")
}

enum ReportFormat {
  csv
  pdf
}

model Report {
  id      String @id @default(uuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  format      ReportFormat
  fileUrl     String?
  requestedBy String // FK → auth-service.User.id (sin constraint de BD)

  createdAt DateTime @default(now())

  @@map("reports")
}

// Inmutable — instancia LOCAL de auditoría de core-service.
model AuditLog {
  id          BigInt  @id @default(autoincrement())
  tableName   String
  recordId    String
  action      String
  before      Json?
  after       Json?
  performedBy String // desde JWT userId — sin llamada cruzada
  requestId   String?

  createdAt DateTime @default(now())

  @@map("audit_log")
}
