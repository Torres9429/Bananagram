# Copia este archivo a .env y ajusta lo que necesites. Los valores por
# defecto ya funcionan para desarrollo local con `docker compose up -d`.

# auth-service y core-service tienen bases de datos separadas (ver
# docs/base/modelo2.txt) — puerto 5433 es el que expone docker-compose.yml.
DATABASE_URL_AUTH=postgresql://postgres:postgres@localhost:5433/gestor_redes_auth

# RS256 + JWKS: solo auth-service tiene la llave privada. Ruta relativa al cwd
# del proceso (apps/backend/services/auth-service cuando corre vía
# `pnpm --filter @repo/auth-service dev`) — de ahí 4 niveles hasta la raíz
# del repo, donde `pnpm generate-keys` escribe el par de llaves.
JWT_PRIVATE_KEY_PATH=../../../../keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=../../../../keys/jwt_public.pem
JWT_ISSUER=bananagram-auth
JWT_AUDIENCE=bananagram-api
JWT_EXPIRES_IN=15m

REDIS_URL=redis://127.0.0.1:6379

CORE_SERVICE_URL=http://localhost:3002

# Secreto compartido para tráfico servicio-a-servicio hacia /internal/* de
# core-service (InternalAuthGuard, header X-Internal-Token) — mismo valor
# debe estar configurado en core-service/.env. Sin esto, esas llamadas
# reciben 401 (el guard falla cerrado si no hay secreto configurado).
INTERNAL_SERVICE_SECRET=dev-internal-secret-change-me

NODE_ENV=development
