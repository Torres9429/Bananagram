generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Identidad y acceso ──────────────────────────────────────────────
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  @@map("roles")
}

model Module {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  permissions RolePermission[]
  @@map("modules")
}

model Action {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  permissions RolePermission[]
  @@map("actions")
}

model RolePermission {
  id       String  @id @default(uuid())
  role     Role    @relation(fields: [roleId], references: [id])
  roleId   String
  module   Module  @relation(fields: [moduleId], references: [id])
  moduleId String
  action   Action  @relation(fields: [actionId], references: [id])
  actionId String
  allowed  Boolean @default(true)
  @@unique([roleId, moduleId, actionId])
  @@map("role_permissions")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role      @relation(fields: [roleId], references: [id])
  roleId        String
  refreshTokens RefreshToken[]
  brandUsers    BrandUser[]
  categories    UserCategory[]
  specialties   UserSpecialty[]
  notifications Notification[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  @@map("refresh_tokens")
}

// ── Catálogos ───────────────────────────────────────────────────────
model Category {
  id              String           @id @default(uuid())
  name            String           @unique
  userCategories  UserCategory[]
  campaignCategories CampaignCategory[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  @@map("categories")
}

model Specialty {
  id              String          @id @default(uuid())
  name            String          @unique
  userSpecialties UserSpecialty[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  @@map("specialties")
}

model SocialNetwork {
  id                 String         @id @default(uuid())
  name               String
  code               String         @unique
  baseEngagementRate Float
  brandProfiles      BrandProfile[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?
  @@map("social_networks")
}

// ── Pivotes de usuario ──────────────────────────────────────────────
model UserCategory {
  userId     String
  categoryId String
  user       User     @relation(fields: [userId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])
  @@id([userId, categoryId])
  @@map("user_categories")
}

model UserSpecialty {
  userId      String
  specialtyId String
  user        User      @relation(fields: [userId], references: [id])
  specialty   Specialty @relation(fields: [specialtyId], references: [id])
  @@id([userId, specialtyId])
  @@map("user_specialties")
}

// ── Marcas ──────────────────────────────────────────────────────────
model Brand {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  type         BrandType     @default(brand)
  logoUrl      String?
  primaryColor String?
  profiles     BrandProfile[]
  brandUsers   BrandUser[]
  campaigns    Campaign[]
  posts        Post[]
  scores       BrandScore[]
  reports      Report[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  @@map("brands")
}

enum BrandType {
  brand
  profile
}

model BrandProfile {
  id              String        @id @default(uuid())
  brand           Brand         @relation(fields: [brandId], references: [id])
  brandId         String
  socialNetwork   SocialNetwork @relation(fields: [socialNetworkId], references: [id])
  socialNetworkId String
  handle          String?
  active          Boolean       @default(true)
  followers       Int           @default(0)
  posts           Post[]
  metrics         PostMetric[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  @@unique([brandId, socialNetworkId])
  @@map("brand_profiles")
}

model BrandUser {
  id        String   @id @default(uuid())
  brand     Brand    @relation(fields: [brandId], references: [id])
  brandId   String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  role      String
  @@unique([brandId, userId])
  @@map("brand_users")
}

// ── Contenido ───────────────────────────────────────────────────────
model Campaign {
  id          String             @id @default(uuid())
  brand       Brand              @relation(fields: [brandId], references: [id])
  brandId     String
  name        String
  description String?
  status      CampaignStatus     @default(active)
  startDate   DateTime
  endDate     DateTime
  team        CampaignTeam[]
  categories  CampaignCategory[]
  posts       Post[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  @@map("campaigns")
}

enum CampaignStatus {
  active
  paused
  finished
}

model CampaignTeam {
  id         String   @id @default(uuid())
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String
  userId     String
  role       String
  @@unique([campaignId, userId])
  @@map("campaign_team")
}

model CampaignCategory {
  campaignId String
  categoryId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])
  @@id([campaignId, categoryId])
  @@map("campaign_categories")
}

model Post {
  id             String            @id @default(uuid())
  brand          Brand             @relation(fields: [brandId], references: [id])
  brandId        String
  brandProfile   BrandProfile      @relation(fields: [brandProfileId], references: [id])
  brandProfileId String
  campaign       Campaign?         @relation(fields: [campaignId], references: [id])
  campaignId     String?
  content        String            @db.Text
  status         PostStatus        @default(borrador)
  scheduledAt    DateTime?
  publishedAt    DateTime?
  createdBy      String
  statusHistory  PostStatusHistory[]
  metrics        PostMetric[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  @@map("posts")
}

enum PostStatus {
  borrador
  en_revision
  aprobado
  rechazado
  programado
  publicado
}

model PostStatusHistory {
  id         BigInt   @id @default(autoincrement())
  post       Post     @relation(fields: [postId], references: [id])
  postId     String
  fromStatus PostStatus?
  toStatus   PostStatus
  changedBy  String
  comment    String?  @db.Text
  createdAt  DateTime @default(now())
  @@map("post_status_history")
}

// ── Analítica ───────────────────────────────────────────────────────
model PostMetric {
  id              String       @id @default(uuid())
  post            Post         @relation(fields: [postId], references: [id])
  postId          String
  brandProfile    BrandProfile @relation(fields: [brandProfileId], references: [id])
  brandProfileId  String
  likes           Int
  comments        Int
  shares          Int
  reach           Int
  engagementRate  Float
  recordedAt      DateTime     @default(now())
  @@map("post_metrics")
}

model BrandScore {
  id            String   @id @default(uuid())
  brand         Brand    @relation(fields: [brandId], references: [id])
  brandId       String
  score         Float
  consistency   Float
  engagement    Float
  coverage      Float
  frequency     Float
  classification String
  snapshotDate  DateTime @default(now())
  @@map("brand_scores")
}

model Report {
  id          String   @id @default(uuid())
  brand       Brand    @relation(fields: [brandId], references: [id])
  brandId     String
  format      ReportFormat
  fileUrl     String?
  requestedBy String
  createdAt   DateTime @default(now())
  @@map("reports")
}

enum ReportFormat {
  csv
  pdf
}

// ── Auditoría ────────────────────────────────────────────────────────
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  tableName  String
  recordId   String
  action     String
  before     Json?
  after      Json?
  performedBy String
  requestId  String?
  createdAt  DateTime @default(now())
  @@map("audit_log")
}

model Notification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@map("notifications")
}
