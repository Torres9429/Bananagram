# Copia este archivo a .env y ajusta lo que necesites. Los valores por
# defecto ya funcionan para desarrollo local con `docker compose up -d`.

# RS256 + JWKS: el gateway valida en el edge contra la llave pública remota
# de auth-service, igual que core-service/alexa-service — nunca firma.
JWT_ISSUER=bananagram-auth
JWT_AUDIENCE=bananagram-api
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json

REDIS_URL=redis://127.0.0.1:6379

# Rate-limit por IP (ver rate-limit.middleware.ts). TRUST_PROXY debe seguir
# en false en desarrollo local (sin proxy propio delante).
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=100
TRUST_PROXY=false

AUTH_SERVICE_URL=http://localhost:3001
CORE_SERVICE_URL=http://localhost:3002
ALEXA_SERVICE_URL=http://localhost:3004
