{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "20",
  "globalEnv": ["NODE_ENV", "DATABASE_URL_AUTH", "DATABASE_URL_CORE", "JWT_SECRET", "JWT_EXPIRES_IN", "AUTH_SERVICE_URL", "CORE_SERVICE_URL"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "dist/**"] },
    "dev":   { "persistent": true, "cache": false },
    "test":  { "dependsOn": ["^build"] },
    "lint":  {}
  }
}
