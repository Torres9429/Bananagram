            {
              "name": "Delete user (soft delete)",
              "request": {
                "method": "DELETE",
                "url": { "raw": "{{authBaseUrl}}/admin/users/{{adminUserId}}", "host": ["{{authBaseUrl}}"], "path": ["admin", "users", "{{adminUserId}}"] },
                "description": "Baja lógica + revoca todos los refresh tokens activos del usuario."
              }
            }
          ]
        },
        {
          "name": "Roles y permisos",
          "item": [
            {
              "name": "List roles (con permisos)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const body = pm.response.json();",
                      "if (Array.isArray(body) && body[0] && body[0].id) { pm.collectionVariables.set('roleId', body[0].id); }"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "url": { "raw": "{{authBaseUrl}}/admin/roles", "host": ["{{authBaseUrl}}"], "path": ["admin", "roles"] },
                "description": "Guarda el primer role.id en {{roleId}} para los requests siguientes de esta carpeta."
              }
            },
            {
              "name": "Get role by id",
              "request": {
                "method": "GET",
                "url": { "raw": "{{authBaseUrl}}/admin/roles/{{roleId}}", "host": ["{{authBaseUrl}}"], "path": ["admin", "roles", "{{roleId}}"] }
              }
            },
            {
