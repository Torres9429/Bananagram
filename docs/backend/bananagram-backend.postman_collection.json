              "request": {
                "method": "GET",
                "url": { "raw": "{{authBaseUrl}}/admin/modules", "host": ["{{authBaseUrl}}"], "path": ["admin", "modules"] },
                "description": "Catálogo de módulos (marcas, campanas, catalogos, ...) — mismos slugs de commons/types/modules.enum.ts."
              }
            },
            {
              "name": "List actions",
              "request": {
                "method": "GET",
                "url": { "raw": "{{authBaseUrl}}/admin/actions", "host": ["{{authBaseUrl}}"], "path": ["admin", "actions"] }
              }
            },
            {
              "name": "Update role permission",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"moduleSlug\": \"reportes\",\n  \"actionSlug\": \"crear\",\n  \"allowed\": true\n}"
                },
                "url": { "raw": "{{authBaseUrl}}/admin/roles/{{roleId}}/permissions", "host": ["{{authBaseUrl}}"], "path": ["admin", "roles", "{{roleId}}", "permissions"] },
                "description": "Upsert sobre role_permissions — el cambio no aparece en un token ya emitido hasta el próximo login/refresh (JWT stateless, ver ADR-0002)."
              }
            }
          ]
        }
      ]
    },
