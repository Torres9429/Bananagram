# Copia este archivo a .env y ajusta lo que necesites. Los valores por
# defecto ya funcionan para desarrollo local con `docker compose up -d`.

# auth-service y core-service tienen bases de datos separadas (ver
# docs/base/modelo2.txt) — puerto 5433 es el que expone docker-compose.yml.
DATABASE_URL_AUTH=postgresql://postgres:postgres@localhost:5433/gestor_redes_auth
DATABASE_URL_CORE=postgresql://postgres:postgres@localhost:5433/gestor_redes_core

# JWT_EXPIRES_IN sigue controlando el TTL del access token (ahora vía firma
# RS256 propia, no @nestjs/jwt). JWT_SECRET ya no se usa: la firma pasó de
# HS256 (secreto compartido) a RS256 (par de llaves) — ver bloque RS256/JWKS
# abajo. Se deja documentado el porqué en vez de solo borrarlo.
JWT_EXPIRES_IN=15m

# RS256 + JWKS: solo auth-service tiene la llave privada (firma); core-service,
# alexa-service y el gateway verifican contra la llave pública publicada en
# /.well-known/jwks.json — nunca pueden firmar tokens. Generar el par con
# `pnpm generate-keys` (no sobrescribe si ya existen).
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_ISSUER=bananagram-auth
JWT_AUDIENCE=bananagram-api
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json

# Redis: denylist de access tokens revocados por logout (auth-service,
# core-service, alexa-service, y el gateway en el edge) + rate-limit por IP
# (gateway). Puerto expuesto por docker-compose.yml.
REDIS_URL=redis://127.0.0.1:6379

# Rate-limit del gateway (ventana fija por IP, ver rate-limit.middleware.ts).
# TRUST_PROXY solo debe ser true si hay un proxy propio delante que escriba
# X-Forwarded-For — nunca confiar en ese header directo del cliente.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=100
TRUST_PROXY=false

# URLs que usa el gateway para reenviar requests (ver
# docs/backend/guia-nuevos-modulos-backend.md §8).
AUTH_SERVICE_URL=http://localhost:3001
CORE_SERVICE_URL=http://localhost:3002

# Usado por el frontend (web-shell y microfrontends) para llamar al gateway.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Ayrshare — usado por core-service al crear una marca (perfil + connect URL
# para vincular redes sociales, ver brands.service.ts) y al sincronizar redes
# conectadas (social-accounts.service.ts). Sin estos 4 valores, POST /brands
# y POST /brands/:id/social-accounts/sync fallan con 500.
AYRSHARE_API_KEY=
AYRSHARE_DOMAIN=
AYRSHARE_PRIVATE_KEY=
AYRSHARE_API_BASE_URL=https://api.ayrshare.com/api

NODE_ENV=development
